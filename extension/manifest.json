{
  "manifest_version": 3,
  "name": "Faktz",
  "version": "1.0.0",
  "description": " ",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "Open Faktz Sidebar"
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content/content.ts"
      ]
    }
  ]
}